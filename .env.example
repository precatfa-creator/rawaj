# Safe to expose in the Vite browser bundle. Find these in Supabase > Project Settings > API.
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_PUBLISHABLE_OR_ANON_KEY"

# Server-only values. Never prefix these with VITE_. ZAI_API_KEY belongs in
# Supabase Edge Function secrets in production (`supabase secrets set ...`),
# not in the browser bundle.
ZAI_API_KEY="YOUR_ZAI_API_KEY"
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"
SUPABASE_ACCESS_TOKEN="YOUR_PERSONAL_ACCESS_TOKEN"
SUPABASE_PROJECT_REF="YOUR_20_CHARACTER_PROJECT_REF"
SUPABASE_DB_PASSWORD="YOUR_DATABASE_PASSWORD"
ADMIN_EMAIL="precatfa@gmail.com"
ADMIN_PASSWORD="SET_THIS_LOCALLY"
